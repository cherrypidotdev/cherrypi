set -e

# Record the staged files so they can be re-added after formatting.
staged=$(mktemp)
log=$(mktemp)
trap 'rm -f "$staged" "$log"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z > "$staged"

# Format the tree, capturing the formatter's output so a failure can be shown
# instead of swallowed. `if !` (rather than a bare call plus a `$?` check)
# keeps `set -e` from aborting before the message prints.
if ! make format > "$log" 2>&1; then
  echo "Formatting failed. Please run 'make format' manually:" >&2
  echo >&2
  cat "$log" >&2
  exit 1
fi

# Re-add the staged files, whose formatting may have changed on disk.
xargs -0 -r git add -- < "$staged"
