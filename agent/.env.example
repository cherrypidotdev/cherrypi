# CherryPi agent configuration (development defaults).
# Copy to .env and adjust. In the container, CHERRYPI_DIR=/root.

# The agency to tunnel to, and the agent's tunnel credentials (`user:password`
# as generated when the agent was registered in the agency). Also settable with
# the --agency-url / --auth flags.
CHERRYPI_AGENCY_URL=
CHERRYPI_AGENT_AUTH=

# CherryPi's data directory: the SQLite database and per-session workspaces
# (sessions/<id>/) live here. Default: ~/.cherrypi.
CHERRYPI_DIR=

# SQLite database path. Default: $CHERRYPI_DIR/cherrypi.sqlite3.
CHERRYPI_DATABASE_DSN=

# Pi executable (name on PATH or absolute path). Default: pi.
PI_BIN=pi

# Override Pi's session storage (`pi --session-dir`). Default: Pi's own setting.
PI_SESSION_DIR=

# Extra CLI args passed to `pi` after `--mode rpc --session-id` (space-separated).
# Used by tests to pin a deterministic model, e.g. `--model test/deterministic`.
PI_ARGS=

# Pi's agent directory (memory/, settings.json, sessions/, …).
# Default: ~/.pi/agent.
PI_CODING_AGENT_DIR=

# Shell executable for root and session terminals. Default: $SHELL, then /bin/bash.
SHELL_BIN=
