# Keep the build context small so COPY layers stay stable and fast. The
# Dockerfiles install dependencies and build everything they need; nothing here
# is required inside the build.

# VCS / agent metadata
.git
.gitea
.github
.pi

# Installed dependencies and local build output (rebuilt in the image)
**/node_modules
**/dist
**/bin
agent/internal/gen
shared/gen
agency/server/internal/gen
agency/sdk/js/src/gen

# NOTE: the gen trees are produced by the Docker `codegen` stage from the
# protos/sql. Excluding the host copies keeps a stale checkout out of the image.

# Embedded SPA: copied from the frontend build stage, not the host
agency/server/cmd/agency/frontenddist

# Local runtime state
cherrypi_home
agent/.env
agent/cherrypi.db
agent/cherrypi.sqlite3
agent/sessions
agent/workspace
*.log
.DS_Store

# Stray `go build` outputs and release artifacts
agency/server/agency
agent/agent
dist
